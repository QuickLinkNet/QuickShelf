{
  "name": "quickshelf",
  "description": "A fast, private cockpit for your NAS document and photo archive – PHP + SQLite, no Docker.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "release": "node scripts/make-release.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:api": "php api/tests/run.php",
    "i18n:check": "node scripts/i18n-keys.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run i18n:check && npm run test:api",
    "demo": "node scripts/demo.mjs",
    "demo:web": "vite --mode demo --port 5200 --strictPort",
    "dev:write": "vite --mode write --port 5191 --strictPort"
  },
  "dependencies": {
    "docx-preview": "^0.4.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuickLinkNet/QuickShelf.git"
  },
  "homepage": "https://github.com/QuickLinkNet/QuickShelf",
  "bugs": {
    "url": "https://github.com/QuickLinkNet/QuickShelf/issues"
  }
}
