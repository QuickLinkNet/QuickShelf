# Alles hier ist OPTIONAL. Ohne .env fuehrt dich beim ersten Oeffnen ein Assistent durch die Einrichtung
# (Archivordner, Passwort, Schreibrechte). Eine .env ueberschreibt die Werte aus dem Assistenten.

# Ordner mit deinem Archiv (absolut, so wie der Webserver ihn sieht)
# DATA_ROOT=/volume1/Archiv

# Das Cockpit liest nur (1). Mit 0 darf es Dateien einsortieren, umbenennen und verschieben (mit Rueckgaengig).
# READ_ONLY=1

# Top-Level-Ordner, die ausgeblendet werden (kommagetrennt)
# EXCLUDE=Tresor,Keys

# Login abschalten (0) - nur in einem vertrauenswuerdigen Heimnetz sinnvoll!
# AUTH=1

# Wohin Suchindex, Merkliste, Login und Vorschaubilder geschrieben werden (muss beschreibbar und
# NICHT oeffentlich erreichbar sein). Standard: api/data
# INDEX_DIR=/volume1/web/archiv-data

# Erlaubter Ursprung, falls das Frontend auf einer anderen Adresse liegt als die API
# CORS_ORIGIN=*

# Optional: OCR-Dienst fuer Scans und PDF-Textextraktion
# OCR_ENABLED=0
# OCR_URL=http://127.0.0.1:7070/ocr
# PDF_TEXT=1
